# --- PlatformIO build artifacts (regenerated by `pio run`) ---
.pio
.cache
compile_commands.json

# Firmware hex/bin archives (compiled_firmware/, compiled_firmware_app/)
# are tracked on purpose so releases can be flashed without building.

# --- VS Code / PlatformIO IDE: machine-specific, regenerated locally ---
.vscode/.browse.c_cpp.db*
.vscode/ipch
.vscode/c_cpp_properties.json
.vscode/launch.json

# --- Local factory backup used for recovery and reverse engineering. ---
combobox_bkp_40000.bin

# --- OS junk ---
.DS_Store
._*
.Spotlight-V100
.fseventsd
Thumbs.db
desktop.ini

# --- Editor / temp files ---
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.tmp
*.log

# --- Python ---
__pycache__/
*.pyc

# --- Не версіонується: правила лишаються локальними ---
.gitignore

# --- Локальний аналіз проєкту (не для репозиторію) ---
ANALYSIS.md
PROCESS.md

# --- Локальні папки з документацією/прошивками (не для репозиторію) ---
deye/
120-200177-01(GD305COMBOX_V102_20230904)/
can_sniffer/backups/

# --- Згенеровані артефакти реверс-аналізу (відтворюються tools/*.py) ---
original_firmware/dumps/*.asm
original_firmware/tools/db.json
original_firmware/tools/__pycache__/

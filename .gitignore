# --- PlatformIO build artifacts (regenerated by `pio run`) ---
.pio
.cache
compile_commands.json
compiled_firmware_app/

# Firmware hex/bin archive compiled_firmware/ is tracked on purpose so
# releases can be flashed without building.

# --- VS Code / PlatformIO IDE: machine-specific, regenerated locally ---
.vscode/

# --- Особисті робочі нотатки та локальні інструкції (не для публічного репозиторію) ---
CODE_REVIEW*.md
USER_MANUAL*.md
IDEAS_BRAINSTORM.md
USER_MANUAL*.html
USER_MANUAL*.pdf
*.pdf
IMG*.*
*.jpeg
*.jpg

# --- Local factory backup used for recovery and reverse engineering. ---
combobox_bkp_40000.bin

# --- OS junk ---
.DS_Store
._*
.Spotlight-V100
.fseventsd
Thumbs.db
desktop.ini

# --- Editor / temp files ---
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.tmp
*.log

# --- Python ---
__pycache__/
*.pyc

# --- Локальні папки з документацією/прошивками (не для репозиторію) ---
deye/
120-200177-01(GD305COMBOX_V102_20230904)/
can_sniffer/backups/

# --- Згенеровані артефакти реверс-аналізу (відтворюються tools/*.py) ---
original_firmware/dumps/*.asm
original_firmware/tools/db.json
original_firmware/tools/__pycache__/
